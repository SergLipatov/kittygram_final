# =====================================
# Параметры базы данных PostgreSQL
# =====================================

# Имя базы данных (создается при первом запуске).
POSTGRES_DB=kittygram_db

# Имя пользователя для доступа к базе данных
POSTGRES_USER=kittygram_user

# Пароль пользователя базы данных (должен быть сложным!)
POSTGRES_PASSWORD=your_strong_password_here

# Хост базы данных (в Docker используйте имя сервиса из docker-compose.yml)
DB_HOST=db

# Порт базы данных (стандартный порт PostgreSQL)
DB_PORT=5432


# =====================================
# Безопасность Django
# =====================================

# Секретный ключ приложения (обязательно замените на уникальный!)
# Сгенерировать можно командой: 
#   python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-key

# Разрешенные хосты (через запятую без пробелов)
# Для продакшена: ваш_домен.ru,IP_сервера
# Для разработки: localhost,127.0.0.1
# Для Docker: backend,gateway
ALLOWED_HOSTS=your-domain.com,localhost,127.0.0.1,backend
